{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "aerosoft360/erp",
    "type": "project",
    "description": "AeroSoft360 Finance and Manufacturing ERP API",
    "license": "proprietary",
    "require": {
        "php": "^8.0.2",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^9.19"
    },
    "require-dev": {},
    "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
        "post-create-project-cmd": ["@php artisan key:generate --ansi"]
    },
    "extra": { "laravel": { "dont-discover": [] } },
    "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "audit": { "block-insecure": false }, "allow-plugins": { "php-http/discovery": true } },
    "minimum-stability": "stable",
    "prefer-stable": true
}
