Options -Indexes -MultiViews
DirectoryIndex index.html

<FilesMatch "^(\.env.*|composer\.(json|lock)|.*\.(sql|sqlite|log|zip|bak))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve the API through the private Laravel application.
    RewriteRule ^api(?:/.*)?$ index.php [L,QSA]

    # Keep compiled assets and ACME certificate challenges available.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # All other client routes load the React application.
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
