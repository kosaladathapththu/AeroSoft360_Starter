APP_NAME=AeroSoft360
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.supuncompanies.com
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_CPANEL_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_CPANEL_DATABASE_USER
DB_PASSWORD="REPLACE_WITH_A_STRONG_DATABASE_PASSWORD"

CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
MAIL_MAILER=log
CORS_ALLOWED_ORIGINS=https://erp.supuncompanies.com
DB_BACKUP_MYSQL_BINARY=/usr/bin/mysqldump
